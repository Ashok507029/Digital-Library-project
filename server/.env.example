# ── Alexandria Digital Library — Environment Config ──────────────────
# COPY this file to .env and fill in your real values
# DO NOT commit .env to git

# ── Server ──────────────────────────────────────────────────────────
PORT=3000

# ── MongoDB ─────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/alexandria

# ── Gmail SMTP (Nodemailer) ──────────────────────────────────────────
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Create an App Password for "Mail" → Copy the 16-char password
# 3. Paste below (remove spaces)
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_16_char_app_password

# ── JWT Secret (any random long string) ─────────────────────────────
JWT_SECRET=alexandria_super_secret_key_change_this

# ── OTP Expiry (minutes) ─────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
